---
import TerminalWindow from './TerminalWindow.astro';

interface Props {
	'astro-code'?: string;
	class?: string;
	language?: string;
	meta?: string;
}

const { language = 'text', meta = '' } = Astro.props;

const metaObj: Record<string, string> = {};
if (meta) {
	meta.split(',').forEach((prop: string) => {
		const tokens = prop.split('=');
		metaObj[tokens[0].trim()] = tokens[1]?.trim() || '';
	});
}

const title = metaObj.title || metaObj.filename || language;
---

<TerminalWindow title={title} titleColor="text-terminal-accent">
	<div class="code-wrapper relative">
		<button
			class="copy-button absolute top-4 right-4 p-2 rounded bg-[#0d1117] hover:bg-[#21262d] text-terminal-textDim hover:text-terminal-accent transition-colors duration-200 text-xs font-mono border border-terminal-border opacity-0 group-hover:opacity-100"
			aria-label="Copy code to clipboard"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
			</svg>
		</button>
		<div class="code-content overflow-x-auto">
			<slot />
		</div>
	</div>
</TerminalWindow>

<style>
	.code-wrapper:hover .copy-button {
		opacity: 1;
	}

	.code-content {
		font-family: ui-monospace, Cascadia Code, Source Code Pro, Menlo, Consolas, Monaco, monospace;
		font-size: 0.875rem;
		line-height: 1.625;
	}
</style>

<script>
	const buttons = document.querySelectorAll('.copy-button');

	buttons.forEach((button) => {
		button.addEventListener('click', async () => {
			const codeWrapper = button.closest('.code-wrapper');
			const codeContent = codeWrapper?.querySelector('code');
			const codeText = codeContent?.textContent;

			if (!codeText) return;

			try {
				await navigator.clipboard.writeText(codeText);
				const originalHTML = button.innerHTML;
				button.innerHTML = `
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
					</svg>
				`;
				button.classList.add('text-terminal-green');
				setTimeout(() => {
					button.innerHTML = originalHTML;
					button.classList.remove('text-terminal-green');
				}, 2000);
			} catch (err) {
				console.error('Failed to copy code:', err);
			}
		});
	});
</script>
